<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Batch tab: pick how many sentences to make, which algorithm to use, and how long a sentence
  may be, then press Generate to list them. Add to Corpus saves the listed sentences so they
  count like an imported file. The progress bar shows only while the database is busy.
  BatchController runs it.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sentencebuilder.ui.BatchController">
  <padding>
    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
  </padding>

  <HBox spacing="8.0" alignment="CENTER_LEFT">
    <Label text="Sentences:"/>
    <TextField fx:id="countField" text="10" prefColumnCount="4"/>
    <Label text="Algorithm:"/>
    <ComboBox fx:id="algorithmBox"/>
    <Label text="Max words:"/>
    <TextField fx:id="maxWordsField" text="20" prefColumnCount="4"/>
    <Button fx:id="generateButton" text="Generate" onAction="#onGenerate"/>
  </HBox>

  <ListView fx:id="resultsList" VBox.vgrow="ALWAYS">
    <placeholder>
      <Label text="Choose how many sentences to make, then press Generate."/>
    </placeholder>
  </ListView>

  <HBox spacing="8.0" alignment="CENTER_LEFT">
    <Button fx:id="addButton" text="Add to Corpus" onAction="#onAddToCorpus"/>
    <ProgressBar fx:id="progressBar" prefWidth="200.0" visible="false" managed="false"/>
  </HBox>

  <Label fx:id="statusLabel" wrapText="true"/>
</VBox>
