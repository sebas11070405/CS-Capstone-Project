<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Word List tab: every stored word with its counts, 50 per page. Click a column header to
  sort by it (the first click sorts low to high, the second high to low). The filter row narrows
  the list by prefix, minimum count, and whether the word starts or ends sentences. Prev and Next
  page through the results. WordListController runs it.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sentencebuilder.ui.WordListController">
  <padding>
    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
  </padding>

  <HBox spacing="8.0" alignment="CENTER_LEFT">
    <Label text="Starts with:"/>
    <TextField fx:id="prefixField" prefColumnCount="8" onAction="#onApply"/>
    <Label text="Min count:"/>
    <TextField fx:id="minTotalField" prefColumnCount="4" onAction="#onApply"/>
    <CheckBox fx:id="startersBox" text="Starts sentences"/>
    <CheckBox fx:id="endersBox" text="Ends sentences"/>
    <Button fx:id="applyButton" text="Apply" onAction="#onApply"/>
    <Button fx:id="clearButton" text="Clear" onAction="#onClear"/>
  </HBox>

  <TableView fx:id="wordTable" VBox.vgrow="ALWAYS">
    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
    <placeholder>
      <Label text="No words match."/>
    </placeholder>
    <columns>
      <TableColumn fx:id="wordColumn" text="Word"/>
      <TableColumn fx:id="totalColumn" text="Total"/>
      <TableColumn fx:id="startColumn" text="Starts sentence"/>
      <TableColumn fx:id="endColumn" text="Ends sentence"/>
    </columns>
  </TableView>

  <HBox spacing="8.0" alignment="CENTER_LEFT">
    <Button fx:id="prevButton" text="Prev" onAction="#onPrev"/>
    <Label fx:id="pageLabel"/>
    <Button fx:id="nextButton" text="Next" onAction="#onNext"/>
    <Button fx:id="refreshButton" text="Refresh" onAction="#onRefresh"/>
    <Label fx:id="statusLabel" wrapText="true"/>
  </HBox>
</VBox>
