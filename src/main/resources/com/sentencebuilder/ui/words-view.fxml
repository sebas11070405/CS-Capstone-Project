<?xml version="1.0" encoding="UTF-8"?>
<!--
  The word lookup panel: a search box, the word's counts, two tables of the words that
  come after and before it, and a small form to fix the counts. WordsController runs it.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sentencebuilder.ui.WordsController">
  <padding>
    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
  </padding>

  <HBox spacing="8.0" alignment="CENTER_LEFT">
    <Label text="Look up a word:"/>
    <TextField fx:id="wordField" promptText="holmes" onAction="#onLookup"/>
    <Button fx:id="lookupButton" text="Look up" onAction="#onLookup"/>
  </HBox>

  <Label fx:id="headingLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
  <Label fx:id="countsLabel"/>

  <HBox spacing="12.0" VBox.vgrow="ALWAYS">
    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
      <Label fx:id="followersTitle" text="Comes after"/>
      <TableView fx:id="followersTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
          <TableColumn fx:id="followerWordColumn" text="Word"/>
          <TableColumn fx:id="followerCountColumn" text="Count"/>
          <TableColumn fx:id="followerPickColumn" text="Picked"/>
        </columns>
      </TableView>
    </VBox>
    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
      <Label fx:id="predecessorsTitle" text="Comes before"/>
      <TableView fx:id="predecessorsTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
          <TableColumn fx:id="predecessorWordColumn" text="Word"/>
          <TableColumn fx:id="predecessorCountColumn" text="Count"/>
          <TableColumn fx:id="predecessorPickColumn" text="Picked"/>
        </columns>
      </TableView>
    </VBox>
  </HBox>

  <HBox spacing="8.0" alignment="CENTER_LEFT">
    <Label text="Fix counts:  Total"/>
    <TextField fx:id="totalField" prefColumnCount="5" disable="true"/>
    <Label text="Start"/>
    <TextField fx:id="startField" prefColumnCount="5" disable="true"/>
    <Label text="End"/>
    <TextField fx:id="endField" prefColumnCount="5" disable="true"/>
    <Button fx:id="saveButton" text="Save" onAction="#onSave" disable="true"/>
  </HBox>

  <Label fx:id="warningLabel" wrapText="true" style="-fx-text-fill: #777777;"
         text="Manual override: this doesn't change the word pair counts, so edited numbers can drift from what the importer counted."/>

  <Label fx:id="statusLabel" wrapText="true"/>
</VBox>
